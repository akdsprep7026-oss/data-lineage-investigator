GOOGLE_API_KEY=your-google-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Investigations Postgres (production: Neon). Leave unset/commented for
# local embedded pgserver. When set, the app always uses this DSN and
# will not fall back to embedded Postgres if the host is unreachable.
# Neon URLs usually include sslmode=require.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated browser origins allowed to call the API (CORS).
# Unset → local Vite defaults (localhost:5173 / 127.0.0.1:5173).
# Production example:
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# ALLOWED_ORIGINS=

# Chroma embedding backend for ingest + retrieval (must match).
#   onnx   — local ONNX MiniLM (default when GOOGLE_API_KEY is unset/placeholder)
#   gemini — Google gemini-embedding-001 (needs a real GOOGLE_API_KEY)
# Leave unset to auto-detect. After changing this, re-run:
#   python -m app.retrieval.ingest
# EMBEDDING_PROVIDER=onnx

# Which LLM answers the sql_analysis and root_cause steps: "gemini"
# (default) or "groq". Leave unset for Gemini. Set to groq to run
# dev/test iterations off Gemini's daily free-tier quota.
#
# Whichever provider is chosen, if its key is missing or still holds the
# placeholder above, the workflow falls back to the other provider and
# then to fully offline heuristics -- it never hard-fails on a missing
# key. Retrieval embeddings are controlled separately via
# EMBEDDING_PROVIDER (above); see app/retrieval/embeddings.py.
LLM_PROVIDER=gemini

# Optional model overrides. Groq deprecates models on short notice, so
# GROQ_MODEL is worth knowing about; see https://console.groq.com/docs/models
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile

# Langfuse tracing for the investigation graph (Step 9). When both keys
# are set, every node span, LLM call, and retry pass is grouped under
# the investigation_id as the session id. Leave as placeholders (or set
# LANGFUSE_TRACING=false) to keep runs fully offline.
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING=true
# LANGFUSE_PUBLIC_TRACES=true  # shareable dashboard link without login
