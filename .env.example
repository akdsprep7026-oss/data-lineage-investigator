GOOGLE_API_KEY=your-google-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Investigations Postgres. Leave unset/commented for local embedded
# pgserver (typical Streamlit / local FastAPI checkout). When set, the
# app always uses this DSN and will not fall back to embedded Postgres
# if the host is unreachable.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- FastAPI / React only (not required for Streamlit) ---
# Comma-separated browser origins allowed to call the API (CORS).
# Unset → local Vite defaults (localhost:5173 / 127.0.0.1:5173).
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# ALLOWED_ORIGINS=

# Minutes of no investigations.updated_at progress before a pending/
# investigating row is reclaimed as needs_human_review on API/Streamlit
# process startup. Default: 30. Must be a positive integer.
# STALE_INVESTIGATION_MINUTES=30

# Chroma embedding backend for ingest + retrieval (must match).
#   onnx   — local ONNX MiniLM (default when GOOGLE_API_KEY is unset/placeholder)
#   gemini — Google gemini-embedding-001 (needs a real GOOGLE_API_KEY)
# Leave unset to auto-detect. After changing this, re-run:
#   python -m app.retrieval.ingest
# EMBEDDING_PROVIDER=onnx

# Which LLM answers the sql_analysis and root_cause steps: "gemini"
# (default) or "groq". Leave unset for Gemini. Set to groq to run
# dev/test iterations off Gemini's daily free-tier quota.
#
# Whichever provider is chosen, if its key is missing or still holds the
# placeholder above, the workflow falls back to the other provider and
# then to fully offline heuristics -- it never hard-fails on a missing
# key. Retrieval embeddings are controlled separately via
# EMBEDDING_PROVIDER (above); see app/retrieval/embeddings.py.
LLM_PROVIDER=gemini

# Optional model overrides. Groq deprecates models on short notice, so
# GROQ_MODEL is worth knowing about; see https://console.groq.com/docs/models
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile

# Langfuse tracing for the investigation graph (Step 9). Exact names
# used by app/graph/tracing.py. When both keys are set (and not
# placeholders), every node span, LLM call, and retry pass is grouped
# under the investigation_id as the session id. Leave as placeholders
# (or set LANGFUSE_TRACING=false) to keep runs fully offline.
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING=true
# LANGFUSE_PUBLIC_TRACES=true  # shareable dashboard link without login

# --- Streamlit path ---
# Local: streamlit run streamlit_app.py
# Community Cloud entry point: streamlit_app.py
# Uses the same GOOGLE_API_KEY / GROQ_API_KEY / LLM_* / EMBEDDING_* /
# DATABASE_URL / LANGFUSE_* / STALE_INVESTIGATION_MINUTES variables.
# Does not require ALLOWED_ORIGINS or frontend VITE_API_URL.
#
# On Streamlit Community Cloud, set secrets in the dashboard (do NOT commit
# .streamlit/secrets.toml). Recommended Cloud secrets include:
#   DATABASE_URL              # required — external Postgres (not embedded pgserver)
#   STREAMLIT_CLOUD_DEPLOY=true
#   ENABLE_SANDBOX_DEBUG=true   # optional — sidebar Debug: Sandbox Control
#   EMBEDDING_PROVIDER=onnx   # recommended — avoids Gemini embedding quota
#   GOOGLE_API_KEY / GROQ_API_KEY / LLM_PROVIDER / GEMINI_MODEL / GROQ_MODEL
#   LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY / LANGFUSE_BASE_URL
#   LANGFUSE_TRACING / LANGFUSE_PUBLIC_TRACES
#
# STREAMLIT_CLOUD_DEPLOY=true
# ENABLE_SANDBOX_DEBUG=true
#
# Bootstrap (once per process when assets are missing — not every rerun):
#   python -m app.sandbox_data.seed
#   python -m app.retrieval.ingest
# Against external Postgres (once, before durable Cloud history):
#   alembic upgrade head
