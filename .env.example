GOOGLE_API_KEY=your-google-api-key-here
GROQ_API_KEY=your-groq-api-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/data_lineage_investigator

# Which LLM answers the sql_analysis and root_cause steps: "gemini"
# (default) or "groq". Leave unset for Gemini. Set to groq to run
# dev/test iterations off Gemini's daily free-tier quota.
#
# Whichever provider is chosen, if its key is missing or still holds the
# placeholder above, the workflow falls back to the other provider and
# then to fully offline heuristics -- it never hard-fails on a missing
# key. Retrieval embeddings are unaffected (Groq has no embeddings
# endpoint); see app/retrieval/embeddings.py.
LLM_PROVIDER=gemini

# Optional model overrides. Groq deprecates models on short notice, so
# GROQ_MODEL is worth knowing about; see https://console.groq.com/docs/models
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile
